# Copy to .env.local for local dev, and set these in Vercel → Settings → Environment Variables for production.

# Required for the AI Assistant (/assistant). Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: lets the AI Assistant email leads to you (same Formspree form as the contact form).
# Create a free form at https://formspree.io and paste the ID (the part after /f/).
SIGNGO_FORMSPREE_ID=

# --- Leads database + admin dashboard (/admin) ---
# MongoDB connection string (free at https://www.mongodb.com/atlas). Leads from the
# contact form and AI assistant are stored here and shown in the admin dashboard.
MONGODB_URI=
# Optional database name (defaults to "signgo")
MONGODB_DB=signgo
# Password to log into /admin
ADMIN_PASSWORD=
# A long random string used to sign the admin login cookie (e.g. run: openssl rand -hex 32)
ADMIN_SESSION_SECRET=
